<?xml version="1.0" encoding="utf-8"?>
<Mod id="5B898290-38D3-4838-B0B2-D03B96390FBC" version="1">
    <Properties>
        <Name>Auto Battle</Name>
        <Teaser>Automatically fights and positions your military and religious units.</Teaser>
        <Description>Adds an in-game panel with Aggressive / In-Between / Passive modes. When enabled, your combat units automatically choose targets (kill first, then max damage), attack or fortify based on the selected mode's rules, and reposition toward the enemy.</Description>
        <Authors>philip_yin</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <SupportsSinglePlayer>1</SupportsSinglePlayer>
        <SupportsHotSeat>0</SupportsHotSeat>
    </Properties>

    <Dependencies>
        <Mod id="1B28771A-C749-434B-9053-D1380C553DE9" title="LOC_EXPANSION1_MOD_TITLE" />
        <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE" />
    </Dependencies>

    <References>
        <!-- Load after the base UI so we can attach our panel. -->
    </References>

    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>

    <Components>
        <!-- Localized text -->
        <UpdateDatabase id="AutoBattle_Text">
            <Properties>
                <LoadOrder>10</LoadOrder>
            </Properties>
            <Items>
                <File>Text/AutoBattle_Text.xml</File>
            </Items>
        </UpdateDatabase>
    </Components>

    <FrontEndActions></FrontEndActions>

    <InGameActions>
        <!-- Import both Lua files into the InGame UI context so they share one
             Lua VM. AutoBattle.lua does include("AutoBattleLogic") to call the
             brain directly. The brain lives in the UI context because that is
             where CombatManager / UnitManager / PlayersVisibility are bound. -->
        <ImportFiles id="AutoBattle_UI_Import" criteria="always">
            <Properties>
                <LoadOrder>20</LoadOrder>
            </Properties>
            <File>UI/AutoBattleLogic.lua</File>
            <File>UI/AutoBattle.lua</File>
            <File>UI/AutoBattle.xml</File>
        </ImportFiles>

        <AddUserInterfaces id="AutoBattle_UI" criteria="always">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>30</LoadOrder>
            </Properties>
            <File>UI/AutoBattle.xml</File>
        </AddUserInterfaces>
    </InGameActions>

    <Files>
        <File>Text/AutoBattle_Text.xml</File>
        <File>UI/AutoBattleLogic.lua</File>
        <File>UI/AutoBattle.lua</File>
        <File>UI/AutoBattle.xml</File>
    </Files>
</Mod>
