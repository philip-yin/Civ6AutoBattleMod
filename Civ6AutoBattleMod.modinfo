<?xml version="1.0" encoding="utf-8"?>
<Mod id="5B898290-38D3-4838-B0B2-D03B96390FBC" version="1">
    <Properties>
        <Name>Auto Battle</Name>
        <Teaser>Automatically fights and positions your military and religious units.</Teaser>
        <Description>Adds an in-game panel with Aggressive / In-Between / Passive modes. When enabled, your combat units automatically choose targets (kill first, then max damage), attack or hold based on the selected mode's rules, and reposition toward the enemy.</Description>
        <Authors>philip_yin</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <SupportsSinglePlayer>1</SupportsSinglePlayer>
        <SupportsHotSeat>0</SupportsHotSeat>
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>

    <ActionCriteria>
        <Criteria id="AlwaysMet" any="1">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>

    <Components>
        <!-- Localized text loads into the database. -->
        <UpdateDatabase id="AutoBattle_Text">
            <Items>
                <File>Text/AutoBattle_Text.xml</File>
            </Items>
        </UpdateDatabase>

        <!-- Make the Lua/XML files importable so the panel's <Lua> binding and
             include("AutoBattleLogic") can resolve them by name. -->
        <ImportFiles id="AutoBattle_Import">
            <Items>
                <File>UI/AutoBattleLogic.lua</File>
                <File>UI/AutoBattle.lua</File>
                <File>UI/AutoBattle.xml</File>
            </Items>
        </ImportFiles>
    </Components>

    <InGameActions>
        <!-- Inject the panel into the InGame HUD context. -->
        <AddUserInterfaces id="AutoBattle_UI" criteria="AlwaysMet">
            <Properties>
                <Context>InGame</Context>
            </Properties>
            <File>UI/AutoBattle.xml</File>
        </AddUserInterfaces>
    </InGameActions>

    <Files>
        <File>Text/AutoBattle_Text.xml</File>
        <File>UI/AutoBattleLogic.lua</File>
        <File>UI/AutoBattle.lua</File>
        <File>UI/AutoBattle.xml</File>
    </Files>
</Mod>
