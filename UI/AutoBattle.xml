<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Battle control panel. Anchored top-LEFT of the HUD so it never overlaps
     the right-side Production panel (350px wide, Anchor R,T) shown when a city is
     selected. The engine binds AutoBattle.lua to this context by filename match.
     Every Style/ColorSet name here is a real one from Civ6_Styles.xml; made-up
     names render as nothing (that caused the earlier invisible frame/buttons). -->
<Context Name="AutoBattle">

    <!-- Root container, top-left of the HUD (below the minimap-free left edge). -->
    <Container ID="AutoBattlePanel" Anchor="L,T" Offset="8,140" Size="210,250" Hidden="0">

        <!-- Solid dark backing box so faint text has contrast, then a frame on top. -->
        <Grid Size="210,250" Texture="Controls_SubContainer3" SliceCorner="20,20"
              SliceSize="1,1" Color="0,0,0,200" />
        <GridBox Size="210,250" Style="DecoFrame" />

        <Stack StackGrowth="Bottom" Offset="16,16" WrapWidth="178" Padding="6">

            <!-- Title -->
            <Label ID="TitleLabel" String="LOC_AUTOBATTLE_TITLE" Font="TitleFont"
                   FontSize="18" ColorSet="BodyTextCool" Anchor="L,T" />

            <!-- Enable checkbox. String lives ON the CheckBox (no child Label) so the
                 whole control is clickable; a child Label was eating the clicks. -->
            <CheckBox ID="EnableCheck" Style="WorldTrackerCheckBox" Anchor="L,T" Offset="0,6"
                      String="LOC_AUTOBATTLE_ENABLE" TextOffset="-5" WrapWidth="150"
                      ToolTip="LOC_AUTOBATTLE_ENABLE_TT" />

            <!-- Mode selection: three buttons -->
            <Label String="LOC_AUTOBATTLE_MODE_LABEL" FontSize="13" ColorSet="BodyTextCool" Anchor="L,T" Offset="0,8" />

            <GridButton ID="ModeAggressive" Size="178,32" Style="ButtonControl" Anchor="L,T" Offset="0,2"
                        ToolTip="LOC_AUTOBATTLE_MODE_AGGRESSIVE_TT">
                <Label ID="ModeAggressiveLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_AGGRESSIVE" FontSize="13" ColorSet="ButtonCS" />
            </GridButton>

            <GridButton ID="ModeBalanced" Size="178,32" Style="ButtonControl" Anchor="L,T" Offset="0,2"
                        ToolTip="LOC_AUTOBATTLE_MODE_BALANCED_TT">
                <Label ID="ModeBalancedLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_BALANCED" FontSize="13" ColorSet="ButtonCS" />
            </GridButton>

            <GridButton ID="ModePassive" Size="178,32" Style="ButtonControl" Anchor="L,T" Offset="0,2"
                        ToolTip="LOC_AUTOBATTLE_MODE_PASSIVE_TT">
                <Label ID="ModePassiveLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_PASSIVE" FontSize="13" ColorSet="ButtonCS" />
            </GridButton>

            <!-- Run Now -->
            <GridButton ID="RunNowButton" Size="178,36" Style="ButtonConfirm" Anchor="L,T" Offset="0,10"
                        ToolTip="LOC_AUTOBATTLE_RUN_NOW_TT">
                <Label Anchor="C,C" String="LOC_AUTOBATTLE_RUN_NOW" FontSize="14" ColorSet="ButtonCS" />
            </GridButton>

            <!-- Status line -->
            <Label ID="StatusLabel" String="LOC_AUTOBATTLE_STATUS_IDLE" FontSize="12"
                   ColorSet="BodyTextCool" Anchor="L,T" Offset="0,10" />

        </Stack>
    </Container>
</Context>
