<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Battle control panel. Docked BOTTOM-RIGHT, sitting just ABOVE the End
     Turn button (ActionPanel, R,B, ~215px tall). The root is bottom-anchored so
     the panel's bottom edge stays pinned above End Turn; the title bar is at the
     TOP of the root, so it holds its position when the body is minimized (the body
     just hides, top stays put). Auto-hides under fullscreen popups (see
     AutoBattle.lua). Every Style/ColorSet is a real one from Civ6_Styles.xml. -->
<Context Name="AutoBattle">

    <!-- Offset Y (230) lifts the whole panel above the ~215px End Turn cluster;
         Offset X (70) nudges it further left, clear of the turn/time events
         banner along the right edge. Height is fixed (bottom-anchor keeps the
         bottom put), so minimize only hides the body. -->
    <Container ID="AutoBattlePanel" Anchor="R,B" Offset="70,230" Size="210,274" Hidden="0">

        <!-- ===== Title bar (always visible, at the TOP of the panel) ===== -->
        <Container ID="TitleBar" Size="210,38" Anchor="L,T">
            <!-- Dark backing + ornate DecoFrame so the minimized bar matches the
                 framed look of the full body. -->
            <Grid Size="210,38" Texture="Controls_SubContainer3" SliceCorner="20,20"
                  SliceSize="1,1" Color="0,0,0,220" />
            <GridBox Size="210,38" Style="DecoFrame" />
            <Label ID="TitleLabel" String="LOC_AUTOBATTLE_TITLE" Font="TitleFont"
                   FontSize="16" ColorSet="BodyTextCool" Anchor="L,C" Offset="14,0" />
            <!-- Minimize / expand toggle. -->
            <GridButton ID="MinimizeButton" Size="24,24" Anchor="R,C" Offset="10,0"
                        Texture="Controls_ExpandButton" ToolTip="LOC_AUTOBATTLE_MINIMIZE_TT" />
        </Container>

        <!-- ===== Collapsible body (sits just below the 38px title bar) ===== -->
        <Container ID="BodyContainer" Anchor="L,T" Offset="0,36" Size="210,238" Hidden="0">

            <!-- Solid dark backing box, then a frame on top. -->
            <Grid Size="210,238" Texture="Controls_SubContainer3" SliceCorner="20,20"
                  SliceSize="1,1" Color="0,0,0,200" />
            <GridBox Size="210,238" Style="DecoFrame" />

            <Stack StackGrowth="Bottom" Offset="16,12" WrapWidth="178" Padding="8">

                <!-- ===== Melee config group: a bordered, labeled box so it's
                     visually clear the three modes apply ONLY to melee. ===== -->
                <Grid ID="MeleeModeBox" Size="178,142" Style="SquareFrameGrey" Anchor="L,T">
                    <!-- Header tab on the box border. -->
                    <Label String="LOC_AUTOBATTLE_MELEE_MODE_LABEL" FontSize="12" ColorSet="BodyTextCool"
                           Anchor="L,T" Offset="8,4" />

                    <Stack StackGrowth="Bottom" Anchor="L,T" Offset="8,24" Padding="4">
                        <GridButton ID="ModeAggressive" Size="162,30" Style="ButtonControl" Anchor="L,T"
                                    ToolTip="LOC_AUTOBATTLE_MODE_AGGRESSIVE_TT">
                            <Label ID="ModeAggressiveLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_AGGRESSIVE" FontSize="13" ColorSet="ButtonCS" />
                        </GridButton>
                        <GridButton ID="ModeBalanced" Size="162,30" Style="ButtonControl" Anchor="L,T" Offset="0,2"
                                    ToolTip="LOC_AUTOBATTLE_MODE_BALANCED_TT">
                            <Label ID="ModeBalancedLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_BALANCED" FontSize="13" ColorSet="ButtonCS" />
                        </GridButton>
                        <GridButton ID="ModePassive" Size="162,30" Style="ButtonControl" Anchor="L,T" Offset="0,2"
                                    ToolTip="LOC_AUTOBATTLE_MODE_PASSIVE_TT">
                            <Label ID="ModePassiveLbl" Anchor="C,C" String="LOC_AUTOBATTLE_MODE_PASSIVE" FontSize="13" ColorSet="ButtonCS" />
                        </GridButton>
                    </Stack>
                </Grid>

                <!-- ===== Run buttons, side by side. Melee uses the box above;
                     Ranged is independent (no mode). ===== -->
                <Stack StackGrowth="Right" Anchor="L,T" Offset="0,10" Padding="6">
                    <GridButton ID="RunNowButton" Size="86,36" Style="ButtonConfirm" Anchor="L,T"
                                ToolTip="LOC_AUTOBATTLE_RUN_NOW_TT">
                        <Label Anchor="C,C" String="LOC_AUTOBATTLE_RUN_NOW" FontSize="13" ColorSet="ButtonCS" />
                    </GridButton>
                    <GridButton ID="RunRangedButton" Size="86,36" Style="ButtonConfirm" Anchor="L,T"
                                ToolTip="LOC_AUTOBATTLE_RUN_RANGED_TT">
                        <Label Anchor="C,C" String="LOC_AUTOBATTLE_RUN_RANGED" FontSize="13" ColorSet="ButtonCS" />
                    </GridButton>
                </Stack>

                <Container Size="178,44" Anchor="L,T" Offset="0,10">
                    <Grid Size="178,44" Texture="Controls_SubContainer3" SliceCorner="20,20"
                          SliceSize="1,1" Color="0,0,0,255" Anchor="L,T" />
                    <Label ID="StatusLabel" String="LOC_AUTOBATTLE_STATUS_IDLE" FontSize="12"
                           Color="255,255,255,255" Anchor="L,T" Offset="6,6" />
                </Container>

            </Stack>
        </Container>
    </Container>
</Context>
